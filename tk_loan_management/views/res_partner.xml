<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="customer_load_inherit_res_partner_view_form" model="ir.ui.view">
            <field name="name">customer.loan.inherit.res.partner.view.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='internal_notes']" position="after">
                    <page string="Other Info" name="other_info">
                        <group string="Personal Information">
                            <group>
                                <field name="personal_number" required="1"/>
                                <field name="date_of_issuing" required="1"/>
                                <field name="issued_by"/>
                            </group>
                            <group>
                                <field name="id_card" required="1"/>
                                <field name="validity_type" widget="radio"
                                       options="{'horizontal': True}"/>
                                <field name="date_of_validity"
                                       readonly="validity_type == '10_years'" force_save="1"/>
                            </group>
                        </group>
                        <div class="o_horizontal_separator mb-3 text-uppercase fw-bolder small mt-4">
                            Roles
                        </div>
                        <div class="d-flex">
                            <field name="is_loan_borrower"/>
                            <label for="is_loan_borrower"/>
                            <field name="is_person_of_contact"/>
                            <label for="is_person_of_contact"/>
                            <field name="is_codebtor"/>
                            <label for="is_codebtor"/>
                        </div>
                        <group>
                            <group string="Labour Information">
                                <field name="labour_relation_id"
                                       options="{'no_create_edit': True, 'no_create': True}"/>
                                <field name="employer"/>
                                <field name="date_of_salary_to" widget="radio"
                                       options="{'horizontal': True}"/>
                                <span class="o_form_label o_td_label" name="address_name">Address
                                </span>
                                <div class="o_address_format">
                                    <field name="ep_street" placeholder="Street..."
                                           class="o_address_street"/>
                                    <field name="ep_street2" placeholder="Street 2..."
                                           class="o_address_street"/>
                                    <field name="ep_city" placeholder="City"
                                           class="o_address_city"/>
                                    <field name="ep_state_id" class="o_address_state"
                                           placeholder="State"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                    <field name="ep_zip" placeholder="ZIP" class="o_address_zip"/>
                                    <field name="ep_country_id" placeholder="Country"
                                           class="o_address_country"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                </div>
                            </group>
                            <group string="Payment Details">
                                <field name="bank_account"/>
                                <field name="payment_method" widget="radio"
                                       options="{'horizontal': true}"/>
                            </group>
                            <group string="Family Details">
                                <field name="family_info_id"
                                       options="{'no_create_edit': True, 'no_create': True}"/>
                                <field name="no_of_children"/>
                            </group>
                            <group string="Codebtor Details">
                                <field name="codebtor_ids" widget="many2many_tags"
                                       options="{'no_create_edit': True, 'no_create': True}"/>
                            </group>
                        </group>
                    </page>
                    <page string="Income/Expense">
                        <group>
                            <group string="Incomes">
                                <field name="income_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="type" required="1"/>
                                        <field name="amount" widget="monetary" sum="sum"
                                               options="{'currency_field': 'currency_id'}"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Expenses">
                                <field name="expense_line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="type" required="1"/>
                                        <field name="company_name" required="1"/>
                                        <field name="amount" widget="monetary" sum="sum"
                                               options="{'currency_field': 'currency_id'}"/>
                                        <field name="monthly_payment" widget="monetary" sum="sum"
                                               options="{'currency_field': 'currency_id'}"/>
                                    </list>
                                </field>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>