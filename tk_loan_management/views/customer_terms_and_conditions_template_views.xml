<odoo>
    <data>
        <record id="customer_terms_and_conditions_template_form_view" model="ir.ui.view">
            <field name="name">customer.terms.and.conditions.template.form.view</field>
            <field name="model">customer.terms.and.conditions.template</field>
            <field name="arch" type="xml">
                <form string="Terms &amp; Conditions Template">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Title"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <notebook>
                            <page name="terms_and_conditions" string="Terms &amp; Conditions">
                                <field name="terms_and_conditions" placeholder="Terms and conditions."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="customer_terms_and_conditions_template_tree_view" model="ir.ui.view">
            <field name="name">customer.terms.and.conditions.template.tree.view</field>
            <field name="model">customer.terms.and.conditions.template</field>
            <field name="arch" type="xml">
                <list string="Loan Type">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="customer_terms_and_conditions_template_action" model="ir.actions.act_window">
            <field name="name">Terms &amp; Conditions Templates</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">customer.terms.and.conditions.template</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new terms and conditions template.
                </p>
            </field>
        </record>
    </data>
</odoo>