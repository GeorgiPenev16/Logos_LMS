#. module: tk_loan_management
#: model:mail.template,body_html:tk_loan_management.installment_overdue_penalty_mail_template
msgid ""
"<style>\n"
"                    .text-right {\n"
"                    text-align: right;\n"
"                    }\n"
"                    .text-center {\n"
"                    text-align: left;\n"
"                    }\n"
"                    tr:nth-child(even) {background-color: #f2f2f2;}\n"
"                    .center {\n"
"                    margin-left: 3rem;\n"
"                    margin-right: 3rem;\n"
"                    padding-left: 3rem;\n"
"                    padding-right:3rem;\n"
"                    }\n"
"                </style>\n"
"                <body><p>Dear\n"
"                    <t t-out=\"object.customer_id.name\"/>,\n"
"                </p>\n"
"                <p>I hope this message finds you well. We are writing to inform you that there are overdue\n"
"                    installments on your loan account, along with the associated penalties for late payment. As per the\n"
"                    terms of your loan agreement, penalties have been applied due to the delay.\n"
"                </p>\n"
"\n"
"                <t t-set=\"total_due\" t-value=\"0\"/>\n"
"                <t t-set=\"installment_total\" t-value=\"0\"/>\n"
"                <t t-set=\"interest_total\" t-value=\"0\"/>\n"
"                <t t-set=\"installment_total_with_interest\" t-value=\"0\"/>\n"
"\n"
"                <table t-if=\"object.loan_lines_ids\" style=\"border:1px solid; border-collapse: collapse; width:90%;\">\n"
"                    <tr style=\"border:1px solid; padding:0.625rem;background-color: #FFBF61;\">\n"
"                        <th colspan=\"5\" style=\"border:1px solid; padding:0.625rem; text-align:center;\">Installment\n"
"                            overdue breakdown\n"
"                        </th>\n"
"                    </tr>\n"
"                    <tr style=\"border:1px solid; padding:0.625rem;background-color: #FFE6A5;\">\n"
"                        <th style=\"border:1px solid; padding:0.625rem;text-align:right;\">Installment No.</th>\n"
"                        <th style=\"border:1px solid; padding:0.625rem;text-align:right;\">Installment Date.</th>\n"
"                        <th style=\"border:1px solid; padding:0.625rem;text-align:right;\">Installment Amount without\n"
"                            Interest\n"
