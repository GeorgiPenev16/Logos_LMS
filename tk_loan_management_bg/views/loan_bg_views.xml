<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--
            Разширение на формата за кредит.
            Добавя „Представляван от", табове за съдлъжници и поръчители.
        -->
        <record id="customer_loan_bg_inherit_form_view" model="ir.ui.view">
            <field name="name">customer.loan.bg.inherit.form.view</field>
            <field name="model">customer.loan</field>
            <field name="inherit_id"
                   ref="tk_loan_management.customer_loan_form_view"/>
            <field name="arch" type="xml">

                <!-- ═══ HIDE base accounting/journal groups — managed via Settings ═══ -->
                <xpath expr="//group[@name='accounting_details']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group[@name='journal_details']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- ═══ ПРЕДСТАВЛЯВАН ОТ — само за фирмени клиенти ═══ -->
                <xpath expr="//field[@name='phone']" position="before">
                    <field name="represented_by"
                           options="{'no_create_edit': True, 'no_create': True}"
                           invisible="not customer_id.is_company"
                           readonly="status != 'draft'"/>
                </xpath>

                <!-- ═══ ТАБ „СЪДЛЪЖНИЦИ" ═══ -->
                <xpath expr="//page[@name='repayment_terms']" position="after">
                    <page name="codebtors_bg" string="Съдлъжници / Co-debtors">
                        <field name="codebtor_line_ids" nolabel="1"
                               readonly="status not in ('draft', 'confirm')">
                            <list editable="bottom">
                                <field name="partner_id"
                                       options="{'no_create_edit': True, 'no_create': True}"/>
                                <field name="guarantee_percentage" string="Share % / % Съдлъжничество"/>
                            </list>
                        </field>
                    </page>

                    <!-- ═══ ТАБ „ПОРЪЧИТЕЛИ" ═══ -->
                    <page name="guarantors_bg" string="Поръчители / Guarantors">
                        <field name="guarantor_line_ids" nolabel="1"
                               readonly="status not in ('draft', 'confirm')">
                            <list editable="bottom">
                                <field name="partner_id"
                                       options="{'no_create_edit': True, 'no_create': True}"/>
                                <field name="guarantee_percentage" string="Guarantee % / % Поръчителство"/>
                            </list>
                        </field>
                    </page>
                </xpath>

            </field>
        </record>

        <!-- ═══ Phase 5: Generate Document button + generated list in Documents tab ═══ -->
        <record id="customer_loan_bg_documents_view" model="ir.ui.view">
            <field name="name">customer.loan.bg.documents.view</field>
            <field name="model">customer.loan</field>
            <field name="inherit_id"
                   ref="tk_loan_management.customer_loan_form_view"/>
            <field name="arch" type="xml">

                <!-- Add "Generate Document" button next to existing "Request Document" -->
                <xpath expr="//page[@name='customer_loan_documents']/header"
                       position="inside">
                    <button name="action_open_generate_wizard"
                            string="Generate Document / Генерирай документ"
                            type="object"
                            class="btn-secondary"
                            invisible="not id"/>
                </xpath>

                <!-- Generated documents list — after the existing customer_loan_doc_ids field -->
                <xpath expr="//page[@name='customer_loan_documents']//field[@name='customer_loan_doc_ids']"
                       position="after">
                    <separator string="Generated Documents / Генерирани документи"
                               invisible="not generated_document_ids"/>
                    <field name="generated_document_ids" nolabel="1"
                           invisible="not generated_document_ids">
                        <list create="0" delete="1" edit="0">
                            <field name="name"/>
                            <field name="template_id" optional="show"/>
                            <field name="generated_date"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'signed'"
                                   decoration-info="state == 'generated'"
                                   decoration-muted="state == 'draft'"/>
                            <field name="attachment_pdf_id" widget="many2one"
                                   string="PDF" optional="show"/>
                            <field name="attachment_docx_id" widget="many2one"
                                   string="DOCX" optional="show"/>
                        </list>
                    </field>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
