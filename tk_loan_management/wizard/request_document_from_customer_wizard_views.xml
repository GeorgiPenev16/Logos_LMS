<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="req_doc_form_customer_wizard_form_view" model="ir.ui.view">
            <field name="name">request.document.from.customer.form.view</field>
            <field name="model">request.document.from.customer</field>
            <field name="arch" type="xml">
                <form string="Document request" duplicate="0">
                    <group>
                        <group>
                            <field name="customer_loan_id" invisible="1"/>
                            <field name="req_document_from_customer_ids" widget="many2many_tags" string="Documents" options="{'no_create':True}"/>
                            <field name="uploaded_document_ids" widget="many2many_tags" invisible="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_request_document" string="Request Document" type="object"
                                class="oe_highlight"
                                confirm="Are you sure you want to request this documents?"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="req_doc_form_customer_wizard_action" model="ir.actions.act_window">
            <field name="name">Request document from customer</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">request.document.from.customer</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>