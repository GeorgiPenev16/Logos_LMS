<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--
            Разширение на формата за партньор.
            Наследява изгледа на tk_loan_management (не на base),
            за да добави/скрие полета спрямо is_company.

            Fixes applied:
            - BUG 1+2+3: Hide entire "Personal Information" group for companies
              AND override required on each field (belt + suspenders)
            - BUG 4+5: Move manager_id dynamic domain to XML view,
              remove from Python field definition to avoid JS eval errors
        -->
        <record id="partner_bg_inherit_view_form" model="ir.ui.view">
            <field name="name">partner.bg.inherit.view.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id"
                   ref="tk_loan_management.customer_load_inherit_res_partner_view_form"/>
            <field name="arch" type="xml">

                <!-- ═══ ФИРМЕНИ ПОЛЕТА: ЕИК, БУЛСТАТ, МОЛ ═══ -->
                <!-- Вмъкваме нова група преди "Personal Information" -->
                <xpath expr="//page[@name='other_info']/group[@string='Personal Information']"
                       position="before">
                    <group string="Company Information / Фирмени данни"
                           invisible="not is_company">
                        <group>
                            <field name="company_id_bg"/>
                            <field name="bulstat"/>
                        </group>
                        <group>
                            <field name="manager_id"
                                   domain="[('is_company', '=', False)]"
                                   options="{'no_create_edit': True, 'no_create': True}"/>
                        </group>
                    </group>
                </xpath>

                <!-- ═══ FIX: СКРИВАНЕ НА ЛИЧНИ ДАННИ ЗА ФИРМИ ═══ -->
                <!-- Скриваме ЦЯЛАТА група "Personal Information" за фирми -->
                <xpath expr="//page[@name='other_info']/group[@string='Personal Information']"
                       position="attributes">
                    <attribute name="invisible">is_company</attribute>
                </xpath>

                <!-- ЕГН — replace field: invisible + required only for individuals -->
                <xpath expr="//field[@name='personal_number']" position="replace">
                    <field name="personal_number"
                           required="not is_company"
                           invisible="is_company"/>
                </xpath>

                <!-- Дата на издаване — replace field: invisible + required only for individuals -->
                <xpath expr="//field[@name='date_of_issuing']" position="replace">
                    <field name="date_of_issuing"
                           required="not is_company"
                           invisible="is_company"/>
                </xpath>

                <!-- Издаден от — hide for companies -->
                <xpath expr="//field[@name='issued_by']" position="replace">
                    <field name="issued_by"
                           invisible="is_company"/>
                </xpath>

                <!-- Лична карта — replace field: invisible + required only for individuals -->
                <xpath expr="//field[@name='id_card']" position="replace">
                    <field name="id_card"
                           required="not is_company"
                           invisible="is_company"/>
                </xpath>

                <!-- Вид валидност — hide for companies -->
                <xpath expr="//field[@name='validity_type']" position="replace">
                    <field name="validity_type" widget="radio"
                           options="{'horizontal': True}"
                           invisible="is_company"/>
                </xpath>

                <!-- Дата на валидност — hide for companies -->
                <xpath expr="//field[@name='date_of_validity']" position="replace">
                    <field name="date_of_validity"
                           readonly="validity_type == '10_years'" force_save="1"
                           invisible="is_company"/>
                </xpath>

                <!-- ═══ РОЛЯ „ПОРЪЧИТЕЛ" В СЕКЦИЯ ROLES ═══ -->
                <!-- Добавяме след is_codebtor -->
                <xpath expr="//field[@name='is_codebtor']" position="after">
                    <field name="is_guarantor"/>
                    <label for="is_guarantor"/>
                </xpath>

                <!-- ═══ СКРИВАНЕ НА СЕКЦИИ ЗА ФИЗИЧЕСКИ ЛИЦА КОГАТО Е ФИРМА ═══ -->
                <!-- Семейни данни — скриваме за фирми -->
                <xpath expr="//group[@string='Family Details']" position="attributes">
                    <attribute name="invisible">is_company</attribute>
                </xpath>

                <!-- Трудова информация — скриваме за фирми -->
                <xpath expr="//group[@string='Labour Information']" position="attributes">
                    <attribute name="invisible">is_company</attribute>
                </xpath>


            </field>
        </record>
    </data>
</odoo>
