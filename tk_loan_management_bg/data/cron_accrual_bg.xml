<?xml version="1.0" encoding="utf-8"?>
<!--
    GROUP C — Interest Accrual Cron
    Runs daily at 06:00: posts DR 4960 / CR 7210 for each installment due today.
    noupdate=0 so interval/time can be adjusted without data reset.
-->
<odoo>
    <data noupdate="0">

        <record id="cron_lms_interest_accrual" model="ir.cron">
            <field name="name">LMS: Post Interest Accruals / Начисляване на лихви</field>
            <field name="model_id" ref="tk_loan_management.model_customer_loan"/>
            <field name="state" eval="'code'"/>
            <field name="code">model._cron_post_interest_accrual()</field>
            <field name="interval_number" eval="1"/>
            <field name="interval_type">days</field>
            <field name="numbercall" eval="-1"/>
            <field name="active" eval="True"/>
            <field name="priority" eval="5"/>
        </record>

    </data>
</odoo>
