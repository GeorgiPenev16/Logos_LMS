<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--
            Bulgarian partner form extension.
            Inherits base.view_partner_form with priority 99.

            IMPORTANT: Odoo 19 does NOT allow @string as xpath selector.
            Use field-based selectors instead: group[.//field[@name='...']]
        -->
        <record id="partner_bg_inherit_view_form" model="ir.ui.view">
            <field name="name">partner.bg.inherit.view.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">

                <!-- ═══ SETTLEMENT LOOKUP — inside Labour Information address block ═══ -->
                <!-- Placed before ep_city so selecting fills ep_city/ep_zip/ep_state_id -->
                <xpath expr="//field[@name='ep_city']" position="before">
                    <field name="settlement_id"
                           string="Населено място / Settlement"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </xpath>

                <!-- ═══ COMPANY FIELDS: EIK, BULSTAT, Manager ═══ -->
                <!-- Insert before the group that contains personal_number -->
                <xpath expr="//page[@name='other_info']/group[.//field[@name='personal_number']]"
                       position="before">
                    <group string="Company Information / Фирмени данни"
                           invisible="not is_company">
                        <group>
                            <field name="company_registry"
                                   string="Company ID / ЕИК"/>
                            <field name="bulstat"/>
                        </group>
                        <group>
                            <field name="manager_id"
                                   domain="[('is_company', '=', False)]"
                                   options="{'no_create_edit': True, 'no_create': True}"/>
                        </group>
                    </group>
                </xpath>

                <!-- ═══ HIDE Personal Information group for companies ═══ -->
                <xpath expr="//page[@name='other_info']/group[.//field[@name='personal_number']]"
                       position="attributes">
                    <attribute name="invisible">is_company</attribute>
                </xpath>

                <!-- EGN — required only for individuals -->
                <xpath expr="//field[@name='personal_number']" position="attributes">
                    <attribute name="invisible">is_company</attribute>
                    <attribute name="required">not is_company</attribute>
                </xpath>

                <!-- Date of Issuing — required only for individuals -->
                <xpath expr="//field[@name='date_of_issuing']" position="attributes">
                    <attribute name="invisible">is_company</attribute>
                    <attribute name="required">not is_company</attribute>
                </xpath>

                <!-- Issued by — hide for companies -->
                <xpath expr="//field[@name='issued_by']" position="attributes">
                    <attribute name="invisible">is_company</attribute>
                </xpath>

                <!-- ID Card — required only for individuals -->
                <xpath expr="//field[@name='id_card']" position="attributes">
                    <attribute name="invisible">is_company</attribute>
                    <attribute name="required">not is_company</attribute>
                </xpath>

                <!-- Validity type — hide for companies -->
                <xpath expr="//field[@name='validity_type']" position="attributes">
                    <attribute name="invisible">is_company</attribute>
                </xpath>

                <!-- Date of validity — hide for companies -->
                <xpath expr="//field[@name='date_of_validity']" position="attributes">
                    <attribute name="invisible">is_company</attribute>
                </xpath>

                <!-- ═══ GUARANTOR ROLE in Roles section ═══ -->
                <xpath expr="//field[@name='is_codebtor']" position="after">
                    <field name="is_guarantor"/>
                    <label for="is_guarantor"/>
                </xpath>

                <!-- ═══ HIDE individual-only sections for companies ═══ -->
                <!-- Labour Information — group containing labour_relation_id -->
                <xpath expr="//group[field[@name='labour_relation_id']]" position="attributes">
                    <attribute name="invisible">is_company</attribute>
                </xpath>

                <!-- Family Details — group containing family_info_id -->
                <xpath expr="//group[field[@name='family_info_id']]" position="attributes">
                    <attribute name="invisible">is_company</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
