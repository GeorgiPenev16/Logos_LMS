<odoo>
    <data>
        <record id="customer_repayment_terms_template_form_view" model="ir.ui.view">
            <field name="name">customer.repayment.terms.template.form.view</field>
            <field name="model">customer.repayment.terms.template</field>
            <field name="arch" type="xml">
                <form string="Repayment Terms Template">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Title"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <notebook>
                            <page name="repayment_terms" string="Repayment Terms">
                                <field name="repayment_terms" placeholder="Repayment Terms."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="customer_repayment_terms_template_tree_view" model="ir.ui.view">
            <field name="name">customer.repayment.terms.template.tree.view</field>
            <field name="model">customer.repayment.terms.template</field>
            <field name="arch" type="xml">
                <list string="Loan Type">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="customer_repayment_terms_template_action" model="ir.actions.act_window">
            <field name="name">Repayment Terms Templates</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">customer.repayment.terms.template</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new repayment terms template.
                </p>
            </field>
        </record>
    </data>
</odoo>