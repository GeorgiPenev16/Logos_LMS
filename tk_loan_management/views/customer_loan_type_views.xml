<odoo>
    <data>
        <record id="customer_loan_type_form_view" model="ir.ui.view">
            <field name="name">customer.loan.type.form.view</field>
            <field name="model">customer.loan.type</field>
            <field name="arch" type="xml">
                <form string="Loan Types" duplicate="0">
                    <field name="currency_id" invisible="1"/>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Title"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="">
                                <field name="is_interest"/>
                                <field name="interest_rate" invisible="not is_interest"/>
                                <field name="company_id" options="{'no_create':True}"/>
                                <field name="is_overdue_penalty_interest"/>
                                <label for="od_penalty_interest" class="fw-bold text-dark"
                                       invisible="not is_overdue_penalty_interest"/>
                                <div name="od_penalty_interest" invisible="not is_overdue_penalty_interest">
                                    <field name="od_penalty_interest" class="oe_inline me-2"/>
                                    <strong>
                                        %
                                    </strong>
                                </div>

                            </group>
                            <group string="">
                                <field name="product_id" required="0" readonly="1" force_save="1"/>
                                <field name="type" readonly="1" force_save="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="loan_terms" string="Terms">
                                <group col="12" class="oe_invoice_lines_tab">
                                    <group colspan="6">
                                        <field name="term_template_id"
                                               options="{'no_create':True}"/>
                                        <field name="term_lines_ids" colspan="2" nolabel="1">
                                            <list editable="bottom">
                                                <field name="loan_type_id" column_invisible="1"/>
                                                <field name="installment_type"/>
                                                <field name="duration"/>
                                                <field name="interest_rate"/>
                                            </list>
                                        </field>
                                    </group>
                                </group>
                            </page>

                            <page string="Fee Details">
                                <group>
                                    <group string="Fee">
                                        <field name="is_fee" store="1"/>
                                        <label for="fee_amount" class="fw-bold text-dark"
                                               invisible="not is_fee"/>
                                        <div name="fee_details" invisible="not is_fee">
                                            <field name="fee_amount" class="oe_inline me-2"
                                                   store="1"/>
                                            <strong>
                                                %
                                            </strong>
                                        </div>
                                    </group>

                                    <group string="Initial Fee">
                                        <field name="is_initial_fee" store="1"/>
                                        <label for="initial_fee_amount" class="fw-bold text-dark"
                                               invisible="not is_initial_fee"/>
                                        <div name="initial_fee_details"
                                             invisible="not is_initial_fee">
                                            <field name="initial_fee_amount" store="1"
                                                   class="oe_inline me-2"/>
                                            <strong>
                                                %
                                            </strong>
                                        </div>
                                    </group>

                                </group>
                            </page>

                            <page name="loan_documents" string="Documents">
                                <group col="12" class="oe_invoice_lines_tab">
                                    <group colspan="6">
                                        <field name="loan_doc_ids" colspan="2" nolabel="1">
                                            <list editable="bottom">
                                                <field name="loan_type_id" column_invisible="1"/>
                                                <field name="document_type_id"
                                                       options="{'no_create':True}"/>
                                            </list>
                                        </field>
                                    </group>
                                </group>
                            </page>
                            <page name="terms_and_conditions" string="Terms &amp; Conditions">
                                <group>
                                    <group>
                                        <field name="terms_and_conditions_template_id"
                                               options="{'no_create':True}"/>
                                    </group>
                                </group>
                                <field name="terms_and_conditions"
                                       placeholder="Terms and conditions."/>
                            </page>
                            <page name="repayment_terms" string="Repayment Terms">
                                <group>
                                    <group>
                                        <field name="repayment_terms_template_id"
                                               options="{'no_create':True}"/>
                                    </group>
                                </group>
                                <field name="repayment_terms" placeholder="Repayment Terms."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="customer_loan_type_tree_view" model="ir.ui.view">
            <field name="name">customer.loan.type.tree.view</field>
            <field name="model">customer.loan.type</field>
            <field name="arch" type="xml">
                <list string="Loan Type" duplicate="0">
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record id="customer_loan_type_action" model="ir.actions.act_window">
            <field name="name">Loan Types</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">customer.loan.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new loan type.
                </p>
            </field>
        </record>
    </data>
</odoo>