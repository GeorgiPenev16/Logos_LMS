<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="customer_loan_crm_lead_inherit_form_view" model="ir.ui.view">
        <field name="name">customer.loan.crm.lead.inherit.form.view</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <xpath expr="//form//header" position="inside">
                <field name="stage_id_name" invisible="1"/>
                <button name="action_create_customer_loan" string="Create Customer Loan"
                        type="object"
                        invisible="not is_in_won_stage or customer_loan_id or loan_req_status in ['in_progress','cancelled']"
                        class="oe_highlight"/>
            </xpath>

            <xpath expr="//form/header" position="after">
                <div class="alert alert-warning text-center" role="alert"
                     invisible="not customer_loan_id">
                    This lead linked to the loan
                    <field name="customer_loan_id" readonly="1"/>
                </div>
            </xpath>

            <xpath expr="//form//header/button[2]" position="attributes">
                <attribute name="invisible">
                    (type == 'lead' or not active and probability &lt; 100 or loan_req_status ==
                    'approved')
                </attribute>
            </xpath>

            <xpath expr="//sheet//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_show_customer_loan" type="object" class="oe_stat_button"
                        icon="fa-university"
                        invisible="not customer_loan_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Customer Loan</span>
                        <span class="o_stat_value">1</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//notebook/page[1]" position="after">
                <page name="customer_requested_loan_details" string="Requested Loan Details">
                    <header>
                        <button name="%(crm.crm_lead_lost_action)d" string="Cancel"
                                title="Mark as lost"
                                type="action"
                                class="btn btn-danger"
                                icon="fa-times"
                                invisible="loan_req_status in ['approved','cancelled']"/>
                        <button name="action_update_customer_details" class="btn btn-primary"
                                string="Update Customer Details"
                                help="By clicking this button, the information of the customer related to the account number, employer address, and payment method. will update as you entered below."
                                type="object" invisible="not partner_id"/>
                        <field name="loan_req_status" widget="statusbar"
                               options="{'clickable':True}"
                               statusbar_visible="in_progress,approved"/>
                    </header>
                    <group string="Requested Loan Details">
                        <group>
                            <field name="approved_loan_type_id" options="{'no_create':True}"
                                   force_save="1"/>
                            <field name="requested_loan_amount"
                                   options="{'currency_field':'currency_id'}"
                                   force_save="1"/>
                            <field name="app_date" readonly="customer_loan_id"/>
                            <field name="customer_loan_id" readonly="1" force_save="1"
                                   invisible="1"/>
                        </group>
                        <group>
                            <field name="requested_installment_type" widget="radio"
                                   options="{'horizontal':True}"
                                   string="Installment Type" force_save="1"/>
                            <label for="requested_term"/>
                            <div name="requested_term">
                                <field name="requested_term" class="oe_inline me-2"
                                       force_save="1"/>
                                <strong invisible="requested_installment_type != 'monthly'">Months
                                </strong>
                                <strong invisible="requested_installment_type != 'quarterly'">
                                    Quarters
                                </strong>
                                <strong invisible="requested_installment_type != 'yearly'">Years
                                </strong>
                            </div>
                            <field name="requested_start_date" readonly="customer_loan_id"/>
                        </group>
                    </group>

                    <group string="Customer Bank Details">
                        <group>
                            <field name="cst_bank_name" readonly="customer_loan_id"/>
                            <field name="cst_bank_account_number" readonly="customer_loan_id"/>
                            <field name="cst_bank_branch_name" readonly="customer_loan_id"/>
                        </group>
                        <group>
                            <field name="cst_bank_branch_code" readonly="customer_loan_id"/>
                            <field name="cst_bank_swift_bic_code" readonly="customer_loan_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Employer Details" name="employer_details">
                            <span class="o_form_label o_td_label" name="address_name">Address
                            </span>
                            <div class="o_address_format">
                                <field name="ep_street" placeholder="Street..."
                                       class="o_address_street"/>
                                <field name="ep_street2" placeholder="Street 2..."
                                       class="o_address_street"/>
                                <field name="ep_city" placeholder="City"
                                       class="o_address_city"/>
                                <field name="ep_state_id" class="o_address_state"
                                       placeholder="State"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                <field name="ep_zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="ep_country_id" placeholder="Country"
                                       class="o_address_country"
                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </div>
                        </group>
                        <group string="Payment Details" name="payment_details">
                            <field name="payment_method" options="{'horizontal': True}"
                                   widget="radio"/>
                            <field name="disbursement_payment_type"
                                   options="{'horizontal': True}" widget="radio"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="customer_documents" string="Documents">
                            <field name="crm_customer_doc_ids">
                                <list editable="bottom">
                                    <field name="crm_customer_loan_id" column_invisible="1"/>
                                    <field name="document_type_id" options="{'no_create':True}"/>
                                    <field name="file_name" column_invisible="1"/>
                                    <field name="document" filename="file_name" widget="binary"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="document_type_id"
                                                   options="{'no_create':True}"/>
                                        </group>
                                        <group>
                                            <field name="file_name" invisible="1"/>
                                            <field name="document" filename="file_name"
                                                   widget="binary"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page name="terms_and_conditions" string="Terms &amp; Conditions">
                            <group>
                                <group>
                                    <field name="terms_and_conditions_template_id"
                                           options="{'no_create':True}"
                                           readonly="loan_req_status != 'in_progress'"/>
                                </group>
                            </group>
                            <field name="terms_and_conditions"
                                   readonly="loan_req_status != 'in_progress'"/>
                        </page>
                        <page name="repayment_terms" string="Repayment Terms">
                            <group>
                                <group>
                                    <field name="repayment_terms_template_id"
                                           options="{'no_create':True}"
                                           readonly="loan_req_status != 'in_progress'"/>
                                </group>
                            </group>
                            <field name="repayment_terms"
                                   readonly="loan_req_status != 'in_progress'"/>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>
</odoo>