<odoo>
    <record id="menu_customer_loan_request" model="website.menu">
        <field name="name">Loan Request</field>
        <field name="url">/customer-loan-request</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">11</field>
    </record>


    <template id="customer_loan_request_form" name="Loan Request">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">
                    <div class="container py-4">
                        <div class="alert alert-danger mt-3 fw-bold text-danger d-none" id="validation-error"
                             role="alert">
                            Enter mandatory field name !!
                        </div>
                        <h2 class="loan-request-details text-primary">Loan Request</h2>
                        <hr class="mt-2"/>
                        <form role="form" id="loanRequestForm" action="/create-loan-request" method="POST"
                              enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <h3 class="mt8 mb8 text-primary fw-bold" style="font-size: 18px;">
                                <i class="fa fa-user-o me-2"/>Personal Information
                            </h3>
                            <hr style="margin: 0px;"/>
                            <div class="row mt-3">
                                <div class="col-md-6 col-sm-12">
                                    <div class="mb-3">
                                        <label for="full_name" class="form-label mb-0">Full Name
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control" id="full_name" name="full_name"
                                               placeholder="Harry Stark" required="required"/>
                                    </div>
                                </div>
                                <div class="col-md-6 col-sm-12">
                                    <div class="mb-3">
                                        <label for="email_address" class="form-label mb-0">Email Address
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input type="email" class="form-control" id="email_address" name="email_address"
                                               placeholder="name@example.com" required="required"/>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-12">
                                    <div class="mb-3">
                                        <label for="customer_phone" class="form-label mb-0">Phone
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input type="phone" class="form-control" id="customer_phone"
                                               name="customer_phone"
                                               placeholder="0123456789" required="required"/>
                                    </div>
                                </div>

                                <div class="col-md-6 col-sm-12">
                                    <div class="mb-3">
                                        <label for="customer_mobile" class="form-label mb-0">Alternate Phone
                                        </label>
                                        <input type="phone" class="form-control" id="customer_mobile"
                                               name="customer_mobile"
                                               placeholder="0123456789"/>
                                    </div>
                                </div>
                            </div>

                            <h3 class="mt8 mb8 text-primary fw-bold" style="font-size: 18px;">
                                <i class="fa fa-user-o me-2"/>Loan Request Information
                            </h3>
                            <hr style="margin: 0px;"/>

                            <div class="row mt-3">
                                <div class="col-md-6 col-sm-12">
                                    <div class="mb-3">
                                        <label for="loan_type" class="form-label mb-0">Loan Type
                                            <span class="text-danger">*</span>
                                        </label>

                                        <select name="loan_type" id="loan_type"
                                                class="form-control link-style" required="required">
                                            <option selected="selected" value="">Select Loan Type</option>
                                            <t t-foreach="loan_types" t-as="type">
                                                <option t-att-value="type.id" t-esc="type.name"/>
                                            </t>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-6 col-sm-12">
                                    <div class="mb-3">
                                        <label for="loan_amount" class="form-label mb-0">Loan Amount
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input type="number" class="form-control" id="loan_amount"
                                               name="loan_amount"
                                               placeholder="50000" required="required"/>
                                    </div>
                                </div>

                                <div class="col-md-6 col-sm-12">
                                    <div class="mb-3">
                                        <label for="installment_type" class="form-label mb-0">Installment Type
                                        </label>

                                        <select name="installment_type" id="installment_type"
                                                class="form-control link-style">
                                            <option selected="selected" value="">Select Installment Type</option>
                                            <option value="monthly">Monthly</option>
                                            <option value="quarterly">Quarterly</option>
                                            <option value="yearly">Yearly</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-6 col-sm-12">
                                    <div class="mb-3">
                                        <label for="term" class="form-label mb-0">Term
                                        </label>
                                        <div class="row align-items-center">
                                            <div class="col-md-4 col-sm-6 mb-md-0 mb-2">
                                                <input type="number" class="form-control" id="term"
                                                       name="term"/>
                                            </div>
                                            <div class="col-md-4 col-sm-6 p-md-0">
                                                <input type="text" class="form-control fw-bold d-none"
                                                       id="select-requested-term" value="Months" disabled="disabled"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">
                                    <div class="mb-3">
                                        <label for="purpose" class="form-label mb-0">Purpose
                                            <span class="text-danger">*</span>
                                        </label>
                                        <textarea class="form-control" id="purpose" name="purpose"
                                                  placeholder="Write a purpose for loan" required="required"/>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="row mb-4">
                                    <div class="col-md-12">
                                        <ul class="nav nav-tabs border-primary" id="documentsTab"
                                            role="tablist">
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link active border-bottom-0"
                                                        id="documents-tab"
                                                        data-bs-toggle="tab"
                                                        data-bs-target="#documents-tab-pane"
                                                        type="button"
                                                        role="tab" aria-controls="documents-tab-pane"
                                                        aria-selected="true">
                                                    Documents
                                                </button>
                                            </li>


                                            <li class="nav-item d-none" role="presentation" id="terms-conditions-tab-li">
                                                <button class="nav-link border-bottom-0"
                                                        id="terms-conditions-tab"
                                                        data-bs-toggle="tab"
                                                        data-bs-target="#terms-conditions-tab-pane"
                                                        type="button"
                                                        role="tab" aria-controls="terms-conditions-tab-pane"
                                                        aria-selected="true">
                                                    Terms &amp; Conditions
                                                </button>
                                            </li>
                                            <li class="nav-item d-none" role="presentation" id="repayment-terms-tab-li">
                                                <button class="nav-link border-bottom-0"
                                                        id="repayment-terms-tab"
                                                        data-bs-toggle="tab"
                                                        data-bs-target="#repayment-terms-tab-pane"
                                                        type="button"
                                                        role="tab" aria-controls="repayment-terms-tab-pane"
                                                        aria-selected="true">
                                                    Repayment Terms
                                                </button>
                                            </li>
                                        </ul>
                                        <div class="tab-content overflow-auto" id="loanEvaluationTabContent">
                                            <!-- documents tab-->
                                            <div class="tab-pane fade show active" id="documents-tab-pane"
                                                 role="tabpanel"
                                                 aria-labelledby="documents-tab" tabindex="0">
                                                <table class="table table-responsive table-sm">
                                                    <thead>
                                                        <tr>
                                                            <th class="p-bold">
                                                                Document Type
                                                            </th>
                                                            <th class="p-bold">
                                                                Document
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="document-details">
                                                    </tbody>
                                                </table>
                                            </div>

                                            <div class="tab-pane p-2 fade show" id="terms-conditions-tab-pane"
                                                 role="tabpanel"
                                                 aria-labelledby="terms-conditions-tab" tabindex="0">

                                            </div>

                                            <div class="tab-pane p-2 fade show" id="repayment-terms-tab-pane"
                                                 role="tabpanel"
                                                 aria-labelledby="repayment-terms-tab" tabindex="0">

                                            </div>


                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-start">
                                <button type="submit" class="btn btn-primary">Submit</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="loan_request_created" name="Loan request submitted">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block">
                    <t t-if="error">
                        <div class="container bg-white mt-1">
                            <div t-attf-class="alert alert-{{error['type']}} alert-dismissible fade show mb-0"
                                 role="alert">
                                <span t-esc="error['message']"/>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="container d-flex justify-content-center align-items-center">
                            <div class="row justify-content-center">
                                <div class="col-lg-12 col-xl-12 text-center">
                                    <span class="d-block fa fa-4x fa-thumbs-up mx-auto rounded-circle bg-primary">
                                    </span>
                                    <br/>
                                    <h1 class="mt-3 mb-2 text-primary">Thank You!</h1>
                                    <div class="pb16 pt16 s_hr" data-snippet="s_hr" data-name="Separator">
                                        <hr class="mx-auto border-top w-50 border-dark text-center"/>
                                    </div>
                                    <h5 class="loan-request-success text-primary mt-2">
                                        <span class="fa fa-check-circle">
                                        </span>
                                        <span>
                                            Your loan request has been successfully submitted.
                                        </span>
                                        <br/>
                                        <a t-attf-href="/track-loan/#{loan_req_lead.access_token}"
                                           class="btn btn-primary mt-3">Track Loan Request
                                        </a>
                                    </h5>
                                </div>
                            </div>
                        </div>
                    </t>
                </section>
            </div>
        </t>
    </template>


    <template id="track_loan_request" name="Track loan request">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block pt40 pb40 o_colored_level" data-snippet="s_text_block">
                    <t t-if="error">
                        <div class="container bg-white mt-1">
                            <div t-attf-class="alert alert-{{error['type']}} alert-dismissible fade show mb-0"
                                 role="alert">
                                <span t-esc="error['message']"/>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="oe_structure">
                            <div class="container py-4">
                                <div t-attf-class="alert #{'alert-info' if loan_req_lead.loan_req_status == 'in_progress' else 'alert-success' if loan_req_lead.loan_req_status == 'approved' else 'alert-danger' if loan_req_lead.loan_req_status == 'cancelled' else '' } alert-dismissible fade show text-center fw-bold"
                                     role="alert">
                                    <i class="fa fa-info-circle" title="info"/>
                                    <span>
                                        Your loan application
                                        <t t-if="loan_req_lead.loan_req_status == 'in_progress'">
                                            is in progress.
                                        </t>
                                        <t t-if="loan_req_lead.loan_req_status == 'approved'">
                                            has been approved.
                                        </t>
                                        <t t-if="loan_req_lead.loan_req_status == 'cancelled'">
                                            has been cancelled.
                                        </t>
                                    </span>
                                </div>

                                <div class="d-block">
                                    <form role="form" id="loanTrackingForm"
                                          action="#" method="POST"
                                          enctype="multipart/form-data">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div>
                                            <div class="row p-2">
                                                <div class="col-md-12 col-sm-12">
                                                    <div class="row">
                                                        <div class="col-md-6 col-sm-12 mb-4">
                                                            <div class="border-bottom border-primary mb-2 pb-2">
                                                                <h5 class="d-inline text-primary">
                                                                    <i class="fa fa-user me-1" aria-hidden="true"></i>
                                                                    Customer Details
                                                                </h5>
                                                            </div>
                                                            <div class="row">
                                                                <div class="col-md-6 col-sm-12 c-field"
                                                                     t-if="loan_req_lead.contact_name">
                                                                    <span class="c-label text-muted">Customer</span>
                                                                    <span class="c-value"
                                                                          t-field="loan_req_lead.contact_name"/>
                                                                </div>
                                                                <div class="col-md-6 col-sm-12 c-field"
                                                                     t-if="loan_req_lead.phone">
                                                                    <span class="c-label text-muted">Phone</span>
                                                                    <span class="c-value"
                                                                          t-field="loan_req_lead.phone"/>
                                                                </div>
                                                                <div class="col-md-6 col-sm-12 c-field"
                                                                     t-if="loan_req_lead.email_from">
                                                                    <span class="c-label text-muted">Email</span>
                                                                    <span class="c-value" style="word-wrap: break-word;"
                                                                          t-field="loan_req_lead.email_from"/>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="col-md-6 col-sm-12 mb-4">
                                                            <div class="border-bottom border-primary mb-2 pb-2">
                                                                <h5 class="d-inline text-primary">
                                                                    <i class="fa fa-university me-1"
                                                                       aria-hidden="true"></i>
                                                                    Requested Loan Details
                                                                </h5>
                                                            </div>
                                                            <div class="row">
                                                                <div class="col-md-6 col-sm-12 c-field"
                                                                     t-if="loan_req_lead.approved_loan_type_id">
                                                                    <span class="c-label text-muted">Loan Type
                                                                    </span>
                                                                    <span class="c-value"
                                                                          t-field="loan_req_lead.approved_loan_type_id.name"/>
                                                                </div>
                                                                <div class="col-md-6 col-sm-12 c-field"
                                                                     t-if="loan_req_lead.requested_loan_amount">
                                                                    <span class="c-label text-muted">Loan
                                                                        Amount
                                                                    </span>
                                                                    <span class="c-value"
                                                                          t-field="loan_req_lead.requested_loan_amount"/>
                                                                </div>
                                                                <div class="col-md-6 col-sm-12 c-field"
                                                                     t-if="loan_req_lead.requested_installment_type">
                                                                    <span class="c-label text-muted">Installment
                                                                        Type
                                                                    </span>
                                                                    <span class="c-value"
                                                                          t-field="loan_req_lead.requested_installment_type"/>
                                                                </div>
                                                                <div class="col-md-6 col-sm-12 c-field"
                                                                     t-if="loan_req_lead.requested_term">
                                                                    <span class="c-label text-muted">Term</span>
                                                                    <span class="c-value"
                                                                          t-field="loan_req_lead.requested_term"/>
                                                                    <t t-if="loan_req_lead.requested_installment_type == 'monthly'">
                                                                        <span class="c-value">Months</span>
                                                                    </t>
                                                                    <t t-if="loan_req_lead.requested_installment_type == 'quarterly'">
                                                                        <span class="c-value">Quarters</span>
                                                                    </t>
                                                                    <t t-if="loan_req_lead.requested_installment_type == 'yearly'">
                                                                        <span class="c-value">Years</span>
                                                                    </t>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row"
                                             t-if="loan_req_lead.loan_req_status in ['in_progress','approved']">
                                            <div class="row mb-4">
                                                <div class="col-md-12">
                                                    <ul class="nav nav-tabs border-primary" id="documentsTab"
                                                        role="tablist">

                                                        <li class="nav-item" role="presentation"
                                                            t-if="loan_req_lead.crm_customer_doc_ids">
                                                            <button class="nav-link active border-bottom-0"
                                                                    id="document-tab"
                                                                    data-bs-toggle="tab"
                                                                    data-bs-target="#document-tab-pane"
                                                                    type="button"
                                                                    role="tab" aria-controls="document-tab-pane"
                                                                    aria-selected="true">
                                                                Documents
                                                            </button>
                                                        </li>
                                                    </ul>
                                                    <div class="tab-content overflow-auto"
                                                         id="documentsTabContent">

                                                        <div class="tab-pane fade show active" id="document-tab-pane"
                                                             role="tabpanel" t-if="loan_req_lead.crm_customer_doc_ids"
                                                             aria-labelledby="document-tab" tabindex="0">
                                                            <table class="table table-responsive table-sm">
                                                                <thead>
                                                                    <tr>
                                                                        <th class="p-bold">
                                                                            Document Type
                                                                        </th>
                                                                        <th class="p-bold">
                                                                            Document
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody id="document-details">
                                                                    <t t-foreach="loan_req_lead.crm_customer_doc_ids"
                                                                       t-as="document">
                                                                        <tr>
                                                                            <td class="cus-value"
                                                                                style="font-size: 0.9rem;">
                                                                                <span t-field="document.document_type_id.name"/>
                                                                            </td>
                                                                            <td class="cus-value"
                                                                                style="font-size: 0.9rem;">
                                                                                <a t-attf-href="/web/content?model=crm.customer.loan.document.lines&amp;id=#{document.id}&amp;field=document&amp;filename_field=file_name&amp;download=true"
                                                                                   t-if="document.document">
                                                                                    <span t-field="document.file_name"/>
                                                                                </a>

                                                                                <span t-if="not document.document"
                                                                                      class="badge text-bg-warning py-1 loan-badge">
                                                                                    Document not uploaded
                                                                                </span>
                                                                            </td>
                                                                        </tr>
                                                                    </t>
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>


                                        <div class="text-start" t-if="loan_req_lead.loan_req_status == 'in_progress'">
                                            <button type="button" class="btn btn-danger" data-bs-toggle="modal"
                                                    data-bs-target="#cancelModal">
                                                Cancel
                                            </button>
                                        </div>
                                    </form>
                                </div>


                                <!--cancel loan form modal-->
                                <div class="modal fade" id="cancelModal" tabindex="-1"
                                     aria-labelledby="cancelModalLabel"
                                     aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form t-attf-action="/customer-cancel-requested-loan/{{loan_req_lead.access_token}}"
                                                  id="cancel-requested-loan-form">
                                                <div class="modal-header">
                                                    <h1 class="modal-title fs-5" id="cancelModalLabel">Cancel Loan
                                                    </h1>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                            aria-label="Close"/>
                                                </div>

                                                <div class="modal-body">
                                                    <span>Are you sure you want to cancel this requested loan
                                                        application?
                                                    </span>
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="submit" id="cancel-requested-loan-button"
                                                            class="btn btn-danger">
                                                        Cancel
                                                    </button>
                                                    <button type="button" class="btn btn-secondary me-auto"
                                                            data-bs-dismiss="modal">
                                                        Close
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </section>
            </div>
        </t>
    </template>


</odoo>