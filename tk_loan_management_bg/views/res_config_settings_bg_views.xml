<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_lms_bg_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.lms.bg.form</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="95"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Loans (БГ)" id="tk_loan_management_bg"
                         string="Loans (БГ)" name="tk_loan_management_bg">

                        <!-- ── Penalty ───────────────────────────────── -->
                        <block title="Penalty Configuration / Наказателна лихва"
                               id="lms_penalty_setting">
                            <setting string="Annual Penalty Rate (%) / Годишна наказателна лихва">
                                <field name="lms_penalty_rate_annual" class="oe_inline"/>
                                <div class="text-muted">
                                    Per ЗПК Art. 33 / Постановление №426/2014. Default: ECB base + 8pp = 10.15%
                                </div>
                            </setting>
                            <setting string="Days Divisor / Делител (дни/година)">
                                <field name="lms_penalty_divisor" class="oe_inline"/>
                            </setting>
                            <setting string="Grace Days / Гратис дни">
                                <field name="lms_penalty_grace_days" class="oe_inline"/>
                            </setting>
                            <setting string="Issue Fee Invoice on Disbursement / Фактура за такса при усвояване">
                                <field name="lms_fee_invoice_on_disburse"/>
                            </setting>
                        </block>

                        <!-- ── Journals ──────────────────────────────── -->
                        <block title="Loan Journals / Кредитни журнали"
                               id="lms_journals_setting">
                            <setting string="Disbursement Journal / Усвояване (LDISB)">
                                <field name="lms_disbursement_journal_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="Collection Journal / Събиране (LCOL)">
                                <field name="lms_collection_journal_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="Operations Journal / Операции (LOPS)">
                                <field name="lms_operations_journal_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="Fee Invoice Journal / Такси (LINV)">
                                <field name="lms_invoice_journal_id"
                                       options="{'no_create': True}"/>
                            </setting>
                        </block>

                        <!-- ── Receivable Accounts ───────────────────── -->
                        <block title="Receivable Accounts / Вземания"
                               id="lms_receivable_accounts_setting">
                            <setting string="LT Loan Account / Дългосрочни заеми (262)">
                                <field name="lms_lt_loan_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="ST Loan Account / Текуща част (4110)">
                                <field name="lms_st_loan_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="Overdue Loan Account / Просрочени (4112)">
                                <field name="lms_overdue_loan_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="Fees Receivable / Вземания такси (4113)">
                                <field name="lms_fees_receivable_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="Accrued Interest / Начислена лихва (4960)">
                                <field name="lms_accrued_interest_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="Loan Loss Allowance / Провизии (2991)">
                                <field name="lms_allowance_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                        </block>

                        <!-- ── Income Accounts ───────────────────────── -->
                        <block title="Income Accounts / Приходи"
                               id="lms_income_accounts_setting">
                            <setting string="Interest Income / Лихви (7210)">
                                <field name="lms_interest_income_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="Fee Income / Такси (7220)">
                                <field name="lms_fee_income_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="Penalty Income / Наказателна лихва (7230)">
                                <field name="lms_penalty_income_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="Early Repayment Fee / Предсрочно (7240)">
                                <field name="lms_early_repayment_income_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                            <setting string="Other LMS Income / Друго (7250)">
                                <field name="lms_other_income_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                        </block>

                        <!-- ── Expense Accounts ──────────────────────── -->
                        <block title="Expense Accounts / Разходи"
                               id="lms_expense_accounts_setting">
                            <setting string="Provision Expense / Разход провизии (6290)">
                                <field name="lms_provision_expense_account_id"
                                       options="{'no_create': True}"/>
                            </setting>
                        </block>

                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
