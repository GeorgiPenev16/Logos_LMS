<odoo>
    <record id="cst_loan_account_move_form_view" model="ir.ui.view">
        <field name="name">customer.loan.account.move.form.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//group[@id='header_left_group']//field[@name='partner_shipping_id']"
                   position="before">
                <field name="customer_loan_id" invisible="not customer_loan_id" readonly="1"
                       force_sace="1"/>
                <field name="customer_installment_id" invisible="not customer_installment_id"
                       readonly="1" force_sace="1"/>
            </xpath>
            <xpath expr="//form//notebook//page[@id='invoice_tab']//field[@name='invoice_line_ids']/list"
                   position="inside">
                <field name="is_cst_principle" column_invisible="1"/>
                <field name="is_cst_principle_penalty" column_invisible="1"/>
                <field name="is_cst_penalty_on_penalty" column_invisible="1"/>
            </xpath>
            <xpath expr="//form//notebook//page[@id='invoice_tab']//field[@name='invoice_line_ids']/list//field[@name='name']"
                   position="attributes">
                <attribute name="readonly">is_cst_principle_penalty or is_cst_principle or is_cst_penalty_on_penalty </attribute>
            </xpath>

            <xpath expr="//page[@name='invoice_tab']/field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                   position="attributes">
                <attribute name="column_invisible">parent.move_type == 'out_invoice' and parent.customer_loan_id
                </attribute>
            </xpath>

            <xpath expr="//page[@name='invoice_tab']/field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                   position="after">
                <field name="loan_price" options="{'currency_field': 'currency_id'}"
                       widget="monetary"
                       column_invisible="parent.move_type != 'out_invoice' or not parent.customer_loan_id"/>
            </xpath>

            <xpath expr="//page[@name='invoice_tab']/field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                   position="after">
                <field name="fee_amount" options="{'currency_field': 'currency_id'}"
                       column_invisible="parent.move_type != 'out_invoice' or not parent.customer_loan_id"
                       widget="monetary" readonly="1" force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>