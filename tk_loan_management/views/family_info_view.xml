<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="customer_loan_family_info_view_list" model="ir.ui.view">
            <field name="name">customer.loan.family.details.view.list</field>
            <field name="model">family.info</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="customer_loan_family_info_view_form" model="ir.ui.view">
            <field name="name">customer.loan.family.details.view.list</field>
            <field name="model">family.info</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Title"/>
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                        </div>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_customer_loan_family_info" model="ir.actions.act_window">
            <field name="name">Family Info</field>
            <field name="view_mode">list,form</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">family.info</field>
        </record>
    </data>
</odoo>