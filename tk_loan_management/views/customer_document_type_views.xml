<odoo>
    <data>
        <record id="customer_document_type_form_view" model="ir.ui.view">
            <field name="name">customer.document.type.form.view</field>
            <field name="model">customer.document.type</field>
            <field name="arch" type="xml">
                <form string="Document Type">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Title"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="customer_document_type_tree_view" model="ir.ui.view">
            <field name="name">customer.document.type.tree.view</field>
            <field name="model">customer.document.type</field>
            <field name="arch" type="xml">
                <list sample="1">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="customer_document_type_action" model="ir.actions.act_window">
            <field name="name">Document Types</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">customer.document.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new document type.
                </p>
            </field>
        </record>
    </data>
</odoo>