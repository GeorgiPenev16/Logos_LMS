<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--
            Phase 5 — QWeb PDF report for generated loan documents.
            Renders the pre-substituted content_rendered field as A4 HTML.
        -->

        <!-- ═══ Report Template ═══ -->
        <template id="loan_document_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page" style="font-family: Arial, sans-serif; font-size: 11pt; line-height: 1.5;">
                            <t t-out="doc.content_rendered"/>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ═══ Report Action ═══ -->
        <record id="loan_document_report_action" model="ir.actions.report">
            <field name="name">Loan Document / Документ</field>
            <field name="model">loan.generated.document</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">tk_loan_management_bg.loan_document_report_template</field>
            <field name="report_file">tk_loan_management_bg.loan_document_report_template</field>
            <field name="print_report_name">
                (object.name or 'document') + '.pdf'
            </field>
            <field name="paperformat_id" ref="base.paperformat_euro"/>
        </record>

    </data>
</odoo>
