<odoo>
    <record id="customer_pre_closure_wizard_form_view" model="ir.ui.view">
        <field name="name">customer.pre.closure.wizard.form.view</field>
        <field name="model">customer.pre.closure.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="loan_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group string="Loan Details">
                    <group>
                        <field name="remaining_loan_principle_amount"/>
                    </group>
                    <group>
                        <field name="outstanding_penalty"/>
                    </group>
                </group>

                <group string="Pre-Closure Details">
                    <group>
                        <field name="is_pre_closure_charge"/>
                        <field name="pre_closure_charge" invisible="not is_pre_closure_charge"/>
                        <field name="pre_closure_interest"/>
                    </group>
                    <group>
                        <field name="pre_closure_interest_amount"/>
                        <field name="pre_closure_installment_amount"/>
                        <field name="pre_closure_total_installment_amount"/>
                    </group>
                </group>

                <footer>
                    <button name="action_pre_close_loan" string="Pre-Close Loan" type="object" class="oe_highlight"
                            confirm="Are you sure you want to pre-close this loan?"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="customer_pre_closure_wizard_action" model="ir.actions.act_window">
        <field name="name">Pre-Closure</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">customer.pre.closure.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

