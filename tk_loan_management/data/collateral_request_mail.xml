<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <record id="collateral_request_mail_template" model="mail.template">
            <field name="name">Collateral Request Email Template</field>
            <field name="model_id" ref="tk_loan_management.model_customer_loan"/>
            <field name="subject">Collateral Upload Request</field>
            <field name="email_from">{{ object.company_id.email_formatted or '' }}</field>
            <field name="email_to">{{ object.email or '' }}</field>
            <field name="body_html" type="html">
                <p>Dear
                    <t t-out="object.customer_id.name"/>,
                </p>
                <p>I hope this message finds you well.</p>
                <p>I am reaching out to kindly remind you to upload the required collateral document for
                    processing your '<t t-out="object.approved_loan_type_id.name"/>' application,loan reference no.
                    <t t-out="object.name"/>.
                </p>

                <p>
                    <strong>Please upload the following types of collateral at your earliest convenience:</strong>
                </p>
                <ul>
                    <t t-foreach="object.collateral_ids" t-as="collateral">
                        <t t-if="collateral.is_requested_from_customer and not collateral.document">
                            <li>
                                <strong t-field="collateral.collateral_type_id.name"/>
                            </li>
                        </t>
                    </t>
                </ul>
                <p>
                    You can upload the collateral documents by logging into your account through the link provided
                    below:
                </p>
                <a t-att-href="object.customer_requested_document_portal_url" role="button" target="_blank" style="border: 1px solid #28a745;
                                                    padding: 4px 24px;
                                                    text-decoration: none;
                                                    color: white;
                                                    background-color: #28a745;
                                                    border-radius: 3px;
                                                    font-size: 0.875rem;
                                                    font-weight: 500;">
                    login
                </a>
                <p>
                    If you need any assistance or have any questions, feel free to reach out, and I'll be happy to help.
                    We look forward to receiving the documents soon.
                </p>

                <p>Best regards,
                    <br/>
                    <t t-out="object.company_id.name"/>
                    <br/>
                    <t t-if="object.company_id.phone">
                        <span>
                            Phone :
                            <t t-out="object.company_id.phone"/>
                        </span>
                        <br/>
                    </t>
                    <t t-if="object.company_id.email">
                        <span>
                            Email :
                            <t t-out="object.company_id.email"/>
                        </span>
                        <br/>
                    </t>
                    <t t-if="object.company_id.website">
                        <span>
                            Website :
                            <t t-out="object.company_id.website"/>
                        </span>
                    </t>
                </p>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>