<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <record id="installment_reminder_mail_template" model="mail.template">
            <field name="name">Installment Reminder Email Template</field>
            <field name="model_id" ref="tk_loan_management.model_customer_loan"/>
            <field name="subject">Reminder: Installment Payment Due</field>
            <field name="email_from">{{ object.company_id.email_formatted or '' }}</field>
            <field name="email_to">{{ object.email or '' }}</field>
            <field name="body_html" type="html">
                <p>Dear
                    <t t-out="object.customer_id.name"/>,
                </p>
                <p>I hope this message finds you well.</p>
                <p>This is a reminder that your installment payment of
                    <t t-out="object.current_installment_amount" t-options='{"widget": "monetary", "display_currency": object.company_id.currency_id}'/>
                    for loan reference no.
                    <t t-out="object.name"/>
                    is due on
                    <span t-field="object.current_installment_due_date"/>
                    . We kindly ask that you make the payment by this date to avoid any late fees or
                    disruptions to your service.
                </p>
                <p>
                    Please find the payment details below:
                </p>
                <ul>
                    <li>
                        <strong>Amount Due:</strong>
                        <t t-out="object.current_installment_amount" t-options='{"widget": "monetary", "display_currency": object.company_id.currency_id}'/>
                    </li>
                    <li>
                        <strong>Due Date:</strong>
                        <span t-field="object.current_installment_due_date"/>
                    </li>
                </ul>
                <p>If you have already made the payment, please disregard this notice. Should you have any questions or
                    require assistance, feel free to reach out to us.
                </p>

                <p>Best regards,
                    <br/>
                    <t t-out="object.company_id.name"/>
                    <br/>
                    <t t-if="object.company_id.phone">
                        <span>
                            Phone :
                            <t t-out="object.company_id.phone"/>
                        </span>
                        <br/>
                    </t>
                    <t t-if="object.company_id.email">
                        <span>
                            Email :
                            <t t-out="object.company_id.email"/>
                        </span>
                        <br/>
                    </t>
                    <t t-if="object.company_id.website">
                        <span>
                            Website :
                            <t t-out="object.company_id.website"/>
                        </span>
                    </t>
                </p>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>